---
import Layout from '../../layouts/Layout.astro';
import BookScene from '../../components/papers/BookScene.astro';
import LearningScript from '../../components/papers/LearningScript.astro';
import {
  getPapers,
  paperUrl,
  questionRevision,
  href,
  formatDate,
} from '../../lib/papers';
import '../../styles/papers.css';
const papers = await getPapers();
---

<Layout
  title="论文学习"
  description="收藏论文与深度技术资料：阅读短报告、译稿，或直接进入完整 HTML 教程。"
>
  <main id="main" class="papers-page paper-library" data-paper-library>
    <div class="papers-container">
      <header class="papers-library-hero">
        <div class="papers-hero-copy">
          <p class="papers-eyebrow">
            <span aria-hidden="true">✦</span> 一次读懂，常常回顾
          </p>
          <h1>
            把论文，
            <br />
            变成自己的知识。
          </h1>
          <p class="papers-lead">
            先选择合适的入口，再深入原文。
            <br class="papers-desktop-break" />
            有的从短报告开始，有的直接阅读完整教程。
          </p>
          <a class="paper-button paper-button-primary" href="#paper-shelf">
            开始学习 <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="papers-hero-art">
          <BookScene />
        </div>
      </header>

      <section class="papers-learning-path" aria-label="学习路径">
        <div>
          <span class="papers-step-number">1</span>
          <p>
            <strong>选入口</strong>
            <span>从短报告或完整原文开始</span>
          </p>
        </div>
        <span class="papers-path-arrow" aria-hidden="true">
          →
        </span>
        <div>
          <span class="papers-step-number papers-step-blue">2</span>
          <p>
            <strong>深阅读</strong>
            <span>沿证据与源码核对细节</span>
          </p>
        </div>
        <span class="papers-path-arrow" aria-hidden="true">
          →
        </span>
        <div>
          <span class="papers-step-number papers-step-gold">3</span>
          <p>
            <strong>再回忆</strong>
            <span>用问题重建核心主线</span>
          </p>
        </div>
      </section>

      <section
        id="paper-shelf"
        class="papers-shelf"
        aria-labelledby="paper-shelf-title"
      >
        <div class="papers-section-heading">
          <div>
            <p class="papers-eyebrow">我的论文书架</p>
            <h2 id="paper-shelf-title">从一个好问题开始。</h2>
          </div>
          <span class="papers-count">{papers.length} 篇论文</span>
        </div>
        <div class="papers-library-grid">
          <div class="papers-cards">
            {papers.map((paper) => {
              const metadata = paper.data.paper;
              const isStudy = metadata.mode === 'study';
              const url = paperUrl(paper);
              return (
                <article
                  class="paper-library-card"
                  data-paper-card={isStudy ? true : undefined}
                  data-paper-id={paper.id}
                  data-question-count={
                    isStudy ? metadata.questions.length : undefined
                  }
                  data-question-revision={
                    isStudy ? questionRevision(metadata.questions) : undefined
                  }
                >
                  <a
                    class="paper-card-cover"
                    href={url}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <span class="paper-cover-tag">
                      {metadata.year} · {metadata.version}
                    </span>
                    {paper.data.cover === 'memory' ? (
                      <div class="paper-memory-art">
                        <span class="paper-memory-small">长期记忆</span>
                        <span class="paper-memory-link">↕</span>
                        <span class="paper-memory-brain">
                          有限上下文<strong>无限的好奇心</strong>
                        </span>
                      </div>
                    ) : (
                      <div class="paper-generic-cover-art">
                        <BookScene compact />
                      </div>
                    )}
                    <span class="paper-cover-title">{metadata.shortTitle}</span>
                  </a>
                  <div class="paper-card-copy">
                    <div class="paper-card-topline">
                      <span class="paper-topic-tag">
                        {isStudy ? '论文精读' : 'HTML 教程'}
                      </span>
                      {isStudy ? (
                        <span class="paper-card-progress" data-card-progress>
                          尚未开始
                        </span>
                      ) : (
                        <span class="paper-card-progress">原始 HTML</span>
                      )}
                    </div>
                    <h3>
                      <a href={url}>{metadata.shortTitle}</a>
                    </h3>
                    <p class="paper-card-original">{metadata.originalTitle}</p>
                    <p class="paper-card-takeaway">{metadata.takeaway}</p>
                    <div class="paper-card-meta">
                      {isStudy ? (
                        <>
                          <span>{metadata.reportPages} 页阅读报告</span>
                          <span>约 {metadata.readingMinutes} 分钟</span>
                          <span>{metadata.questions.length} 道复习题</span>
                        </>
                      ) : (
                        <>
                          <span>完整 HTML 教程</span>
                          <span>约 {metadata.readingMinutes} 分钟</span>
                          <span>固定源码快照</span>
                        </>
                      )}
                    </div>
                    <div class="paper-card-bottom">
                      <a
                        class="paper-button paper-button-primary"
                        href={url}
                        data-card-resume={isStudy ? true : undefined}
                      >
                        {isStudy ? '开始学习' : '阅读全文'}{' '}
                        <span aria-hidden="true">→</span>
                      </a>
                      <time datetime={paper.data.published.toISOString()}>
                        {formatDate(paper.data.published)} 收录
                      </time>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
          <aside class="papers-shelf-aside">
            <span class="papers-aside-icon" aria-hidden="true">
              ↗
            </span>
            <h3>读过，还要能说出来。</h3>
            <p>
              合上论文后，试着回答：它解决了什么问题？关键机制是什么？什么时候不适用？
            </p>
            <div class="papers-aside-divider"></div>
            <h4>为下次回顾留条路</h4>
            <p>
              条目可以直接打开短报告或完整
              HTML；支持复习的论文会把进度保存在当前浏览器。
            </p>
            <a href={href('archive/')}>
              也看看其他学习笔记 <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </section>
    </div>
  </main>
  <LearningScript />
</Layout>
